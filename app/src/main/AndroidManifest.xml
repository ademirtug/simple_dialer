<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Real outgoing calls. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Optional features: denial must not disable manual dialing.
         READ_CALL_LOG is requested/used only while this app is the default phone app. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Android 13+ runtime notification consent; app/channel settings also apply. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:targetApi="33" />
    <!-- Incoming call UI. Android 14+ special access is checked separately at runtime. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:targetApi="29" />

    <!-- Proximity during earpiece calls and a bounded incoming-call screen-wake fallback. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.sensor.proximity" android:required="false" />
    <!-- Contacts remain usable without telephony hardware. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <queries>
        <package android:name="com.miui.securitycenter" />
    </queries>
    <application
        android:name=".DialerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/system_app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dialer">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".launcher.Monochrome" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_monochrome" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Ocean" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true" android:icon="@mipmap/ic_launcher_ocean" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Forest" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_forest" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Rose" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_rose" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Sunset" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_sunset" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity android:name=".telecom.CallActivity" android:exported="false" android:launchMode="singleTop"
            android:taskAffinity="info.pakkudev.simple_dialer.call" android:excludeFromRecents="true"
            android:showWhenLocked="true" android:turnScreenOn="true" />
        <service
            android:name=".telecom.DialerInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <!-- BIND_INCALL_SERVICE protects this service; it is not a user runtime permission. -->
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter><action android:name="android.telecom.InCallService" /></intent-filter>
        </service>
        <receiver android:name=".telecom.CallActionReceiver" android:exported="false" />
    </application>
</manifest>
